<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LingoWay.Views.BrowsePage"
             Title="发现"
             BackgroundColor="{DynamicResource BackgroundPrimary}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- 搜索栏 -->
        <SearchBar Grid.Row="0"
                   x:Name="SearchBar"
                   Placeholder="搜索播客或剧集..."
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextSecondary}"
                   BackgroundColor="{DynamicResource BackgroundSecondary}"
                   SearchButtonPressed="OnSearchButtonPressed"
                   TextChanged="OnSearchTextChanged"
                   HeightRequest="40"
                   Margin="10,2,10,0"/>

        <!-- Tab 切换：推荐 | 我的订阅 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="10,8,10,0" ColumnSpacing="8">
            <Border x:Name="TabRecommend"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="#005FB8" Stroke="Transparent" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabRecommendTapped"/>
                </Border.GestureRecognizers>
                <Label Text="📡 推荐" TextColor="White" FontSize="14" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10"/>
            </Border>
            <Border x:Name="TabMySubs"
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="#2D2D2D" Stroke="#3D3D3D" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabMySubsTapped"/>
                </Border.GestureRecognizers>
                <Label Text="🎧 我的订阅" TextColor="#9CA3AF" FontSize="14"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10"/>
            </Border>
        </Grid>

        <!-- ============ 推荐 Tab 内容 ============ -->
        <Grid Grid.Row="2" x:Name="RecommendPanel">
            <CollectionView x:Name="RecommendList"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,4" CornerRadius="14" HasShadow="True"
                               BorderColor="{DynamicResource CardBackground}"
                               BackgroundColor="{DynamicResource CardBackground}" Padding="0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecommendItemTapped"/>
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12" Padding="12,10" MinimumHeightRequest="72">
                                <Frame Grid.Column="0" CornerRadius="10" Padding="0"
                                       IsClippedToBounds="True" HeightRequest="56" WidthRequest="56"
                                       BackgroundColor="Transparent" BorderColor="Transparent" HasShadow="False">
                                    <Image Source="{Binding CoverUrl}" Aspect="AspectFill"/>
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" TextColor="{DynamicResource TextPrimary}"
                                           FontSize="14" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Author}" TextColor="{DynamicResource TextSecondary}"
                                           FontSize="12" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#1E3A5F"
                                                Stroke="Transparent" Padding="6,2">
                                            <Label Text="{Binding LevelLabel}" TextColor="#7EB8FF" FontSize="10"/>
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#1A3A2A"
                                                Stroke="Transparent" Padding="6,2">
                                            <Label Text="{Binding Category, TargetNullValue='英语', FallbackValue='英语'}"
                                                   TextColor="#22C55E" FontSize="10"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- 右侧操作按钮面板 (点击展开，横排) -->
                                <HorizontalStackLayout Grid.Column="2"
                                                       IsVisible="{Binding IsExpanded}"
                                                       VerticalOptions="Center"
                                                       Spacing="6" Padding="0,0,4,0">
                                    <Border StrokeShape="RoundRectangle 4" BackgroundColor="#005FB8"
                                            Stroke="Transparent" HeightRequest="30" WidthRequest="44" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRecommendDetailTapped"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="详情" TextColor="White" FontSize="10"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10893E"
                                            Stroke="Transparent" HeightRequest="30" WidthRequest="44" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRecommendSubscribeTapped"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="订阅" TextColor="White" FontSize="10"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 4" BackgroundColor="#6B3FA0"
                                            Stroke="Transparent" HeightRequest="30" WidthRequest="44" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRecommendPreviewTapped"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="试听" TextColor="White" FontSize="10"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 4" BackgroundColor="#3D3D3D"
                                            Stroke="Transparent" HeightRequest="30" WidthRequest="44" Padding="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRecommendShareTapped"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="🔗" TextColor="#9CA3AF" FontSize="12"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecommendEmptyTapped"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label x:Name="RecommendEmptyIcon" Text="📻" FontSize="48" HorizontalOptions="Center"/>
                        <Label x:Name="RecommendEmptyText" Text="正在加载推荐..." FontSize="16" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                        <Label x:Name="RecommendEmptyHint" IsVisible="False" Text="点击重试" FontSize="12" TextColor="#005FB8" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- ============ 我的订阅 Tab 内容 ============ -->
        <Grid Grid.Row="2" x:Name="MySubsPanel" IsVisible="False" RowDefinitions="*,Auto" Padding="10,4">

            <CollectionView Grid.Row="0" x:Name="MySubsList"
                            SelectionMode="Single"
                            SelectionChanged="OnSubscribedPodcastSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10"
                              Padding="10,8" HeightRequest="120"
                              BackgroundColor="{DynamicResource CardBackground}">
                            <Frame Grid.Column="0" CornerRadius="8" Padding="0" IsClippedToBounds="True"
                                   HeightRequest="90" WidthRequest="90" VerticalOptions="Center"
                                   BackgroundColor="#1A1D25" BorderColor="Transparent" HasShadow="False">
                                <Image Source="{Binding CoverUrl, TargetNullValue='empty.png', FallbackValue='empty.png'}"
                                       Aspect="AspectFill"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       FontSize="13" FontAttributes="Bold"
                                       MaxLines="1" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Author}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" VerticalOptions="Center"
                                    IsVisible="{Binding HasError}"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="#3A1A1A" Stroke="Transparent"
                                    Padding="6,2">
                                <Label Text="失效" TextColor="#EF4444" FontSize="9"/>
                            </Border>
                            <Border Grid.Column="2" VerticalOptions="Center" x:Name="UnsubBtn"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="#2D2D2D" Stroke="#3D3D3D"
                                    Padding="8,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnsubItemTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#6B7280" FontSize="11"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🎧" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="还没有订阅任何播客" FontSize="16" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <Button Grid.Row="1"
                    x:Name="AddRssButton"
                    Text="+ 添加RSS源"
                    Clicked="OnAddRssClicked"
                    BackgroundColor="#005FB8"
                    TextColor="White"
                    CornerRadius="4" HeightRequest="36"
                    Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</ContentPage>
