<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LingoWay.Views.FavoritesPage"
             Title="收藏"
             BackgroundColor="{DynamicResource BackgroundPrimary}">

    <CollectionView SelectionMode="Single">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10,5"
                      CornerRadius="15"
                      HasShadow="True"
                      BorderColor="{DynamicResource CardBackground}"
                      BackgroundColor="{DynamicResource CardBackground}"
                      Padding="10">
                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="10">
                        <Frame Grid.Column="0" CornerRadius="10" Padding="0" IsClippedToBounds="True" HeightRequest="80" WidthRequest="80" BackgroundColor="Transparent">
                            <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                        </Frame>
                        <StackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{Binding .}" TextColor="{DynamicResource TextPrimary}" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="30分钟 • 已收听" TextColor="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackLayout>
                        <Button Grid.Column="2" Text="❤️" TextColor="{DynamicResource ErrorRed}" BackgroundColor="Transparent" FontSize="18" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>