<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LingoWay.Views.SettingsPage"
             Title="设置"
             BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- 播放设置 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="播放设置" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <!-- 播放速率 -->
                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                                <Label Text="播放速率" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                                <Label Text="{Binding PlaybackRate, StringFormat='{0:F1}x'}" 
                                       FontSize="16" 
                                       TextColor="{DynamicResource PrimaryBrand}"
                                       HorizontalOptions="EndAndExpand"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Slider Value="{Binding PlaybackRate}" 
                                    Minimum="0.5" 
                                    Maximum="2.0"/>
                        </VerticalStackLayout>

                        <!-- 背景播放 -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="允许后台播放" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                            <Switch IsToggled="{Binding IsBackgroundPlayEnabled}" 
                                    HorizontalOptions="EndAndExpand" 
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- 字幕设置 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="字幕设置" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <!-- 启用字幕 -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="启用字幕" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                            <Switch IsToggled="{Binding IsSubtitleEnabled}" 
                                    HorizontalOptions="EndAndExpand"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- 字幕语言 -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="字幕语言" FontSize="16" TextColor="{DynamicResource TextPrimary}"/>
                            <Picker ItemsSource="{Binding SubtitleLanguages}"
                                    SelectedItem="{Binding SubtitleLanguage}"
                                    Title="选择语言"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="{DynamicResource CardBackground}"/>
                        </VerticalStackLayout>

                        <!-- 字幕字号 -->
                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                                <Label Text="字幕字号" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                                <Label Text="{Binding SubtitleFontSize}" 
                                       FontSize="16" 
                                       TextColor="{DynamicResource PrimaryBrand}"
                                       HorizontalOptions="EndAndExpand"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Slider Value="{Binding SubtitleFontSize}" 
                                    Minimum="10" 
                                    Maximum="32"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- 下载设置 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="下载设置" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <!-- WiFi下载 -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="仅WiFi下载" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                            <Label Text="移动网络下禁用自动下载" 
                                   FontSize="12" 
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center"/>
                            <Switch IsToggled="{Binding IsWifiOnlyDownloadEnabled}" 
                                    HorizontalOptions="EndAndExpand"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- 主题设置 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="主题设置" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Button x:Name="LightThemeButton"
                                Text="浅色主题"
                                BackgroundColor="{DynamicResource PrimaryBrand}"
                                TextColor="White"
                                Clicked="OnLightThemeClicked"
                                CornerRadius="8"
                                Padding="10"/>

                        <Button x:Name="DarkThemeButton"
                                Text="深色主题"
                                BackgroundColor="{DynamicResource PrimaryBrand}"
                                TextColor="White"
                                Clicked="OnDarkThemeClicked"
                                CornerRadius="8"
                                Padding="10"/>

                        <Button x:Name="SystemThemeButton"
                                Text="跟随系统"
                                BackgroundColor="{DynamicResource PrimaryBrand}"
                                TextColor="White"
                                Clicked="OnSystemThemeClicked"
                                CornerRadius="8"
                                Padding="10"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- 操作按钮 -->
            <VerticalStackLayout Spacing="10">
                <Button Text="保存设置"
                        Command="{Binding SaveSettingsCommand}"
                        BackgroundColor="#005FB8"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="10"/>

                <Button Text="恢复默认设置"
                        Command="{Binding ResetToDefaultCommand}"
                        BackgroundColor="#C42B1C"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="10"/>
            </VerticalStackLayout>

            <!-- 底部空白 -->
            <BoxView HeightRequest="20" Color="Transparent"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
