<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LingoWay.Views.MainPage"
             Title="首页"
             BackgroundColor="{DynamicResource BackgroundPrimary}">

    <Grid>
        <Button x:Name="PlayCenterButton"
                WidthRequest="160"
                HeightRequest="160"
                BackgroundColor="{DynamicResource CardBackground}"
                TextColor="{DynamicResource TextPrimary}"
                FontSize="48"
                CornerRadius="80"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Text="▶"
                Clicked="OnPlayCenterClicked"/>
    </Grid>

</ContentPage>