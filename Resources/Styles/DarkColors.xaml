<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 深色主题颜色（Mica半透明背景） -->
    <Color x:Key="BackgroundPrimary">#E00A0E27</Color>
    <Color x:Key="BackgroundSecondary">#E01A1F3A</Color>
    <Color x:Key="CardBackground">#F0242A45</Color>
    <Color x:Key="TextPrimary">#E8E9ED</Color>
    <Color x:Key="TextSecondary">#A0A5B3</Color>
    <Color x:Key="PrimaryBrand">#6366F1</Color>
    <Color x:Key="AccentGreen">#10B981</Color>
    <Color x:Key="ErrorRed">#EF4444</Color>

    <!-- 以下为 MAUI 默认样式所需的标准颜色（静态即可） -->
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="OffBlack">#1A1A1A</Color>
    <Color x:Key="OffWhite">#F5F5F5</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#515151</Color>
    <Color x:Key="Gray700">#3D3D3D</Color>
    <Color x:Key="Gray800">#2A2A2A</Color>
    <Color x:Key="Gray900">#1C1C1C</Color>
    <Color x:Key="Gray950">#0F0F0F</Color>
    <Color x:Key="Red">#FF0000</Color>
    <Color x:Key="Green">#00FF00</Color>
    <Color x:Key="Blue">#0000FF</Color>
    <Color x:Key="Yellow">#FFFF00</Color>
    <Color x:Key="Cyan">#00FFFF</Color>
    <Color x:Key="Magenta">#FF00FF</Color>
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    <Color x:Key="PrimaryDarkText">#1A1A1A</Color>
    <Color x:Key="PrimaryLightText">#FFFFFF</Color>
    <Color x:Key="SecondaryDarkText">#3D3D3D</Color>
    <Color x:Key="SecondaryLightText">#B0B0B0</Color>
    <Color x:Key="LightBackground">#F5F5F5</Color>
    <Color x:Key="DarkBackground">#1A1A1A</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="Transparent">Transparent</Color>

</ResourceDictionary>