<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LingoWay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LingoWay"
    xmlns:views="clr-namespace:LingoWay.Views"
    Title="LingoWay - 听途">

    <!-- 标签栏导航 -->
    <TabBar>

        <!-- 播客广场 -->
        <ShellContent Title="播客广场"
                      ContentTemplate="{DataTemplate views:BrowsePage}"
                      Route="BrowsePage" />

        <!-- 播放列表 -->
        <ShellContent Title="播放列表"
                      ContentTemplate="{DataTemplate views:FavoritesPage}"
                      Route="FavoritesPage" />

        <!-- 正在播放（主页） -->
        <ShellContent Title="正在播放"
                      ContentTemplate="{DataTemplate views:PlayerPage}"
                      Route="PlayerPage" />

        <!-- 单词学习 -->
        <ShellContent Title="单词学习"
                      ContentTemplate="{DataTemplate views:VocabularyPage}"
                      Route="VocabularyPage" />

        <!-- 软件设置 -->
        <ShellContent Title="软件设置"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>

</Shell>
